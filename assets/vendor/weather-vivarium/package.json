{
  "name": "weather-vivarium",
  "version": "1.1.0",
  "description": "A tiny living pixel-art weather diorama for any city — dependency-free, driven by real conditions (sun, rain, wind, tide, time of day, landscape, landmark).",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "unpkg": "dist/weather-vivarium.min.js",
  "jsdelivr": "dist/weather-vivarium.min.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./dist/weather-vivarium.min.js": "./dist/weather-vivarium.min.js",
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.md",
    "dist",
    "style.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bash tests/run-tests.sh",
    "test:node": "node --test",
    "build:dist": "node scripts/build-dist.mjs",
    "verify:render": "node verify/render.mjs",
    "build:cities": "node scripts/build-cities.mjs",
    "verify:reference": "node verify/reference.mjs",
    "update:reference": "node scripts/update-reference-snapshot.mjs",
    "verify:replay": "node scripts/replay-cities.mjs",
    "verify:controls": "node verify/page-controls.mjs"
  },
  "keywords": [
    "weather",
    "pixel-art",
    "canvas",
    "diorama",
    "widget",
    "open-meteo",
    "dependency-free",
    "generative"
  ],
  "author": "Chris Portka <chrisportka@gmail.com>",
  "license": "MIT",
  "homepage": "https://cportka.github.io/weather-vivarium/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cportka/weather-vivarium.git"
  },
  "bugs": {
    "url": "https://github.com/cportka/weather-vivarium/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "all-the-cities": "^3.1.0",
    "esbuild": "0.25.5",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "tz-lookup": "^6.1.25"
  }
}
